# Copy this file to .env and fill in real values (do NOT commit .env)

# HTTP server
HTTP_PORT=8080
HTTP_BIND=127.0.0.1

# SMPP connection
SMPP_URL=smpp://texting.airtel.co.ug:9001
# or leave URL blank and use host/port in your code:
SMPP_HOST=texting.airtel.co.ug
SMPP_PORT=9001

# Credentials (placeholders only)
SMPP_SYSTEM_ID=your_system_id_here
SMPP_PASSWORD=your_password_here
SMPP_SENDER_ID=YourSender

# Throughput & timings
SMPP_TPS=20
SMPP_CONNECT_TIMEOUT_MS=30000
SMPP_ENQUIRE_MS=15000
SMPP_RECONNECT_MIN_MS=2000
SMPP_RECONNECT_MAX_MS=30000
